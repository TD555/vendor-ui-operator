# Environment variable names only. Never commit real values.
# Provider selection (anthropic | openai). Default: anthropic
MODEL_PROVIDER=
# Optional model ID override. Defaults: claude-haiku-4-5-20251001 / gpt-4.1-mini
MODEL_NAME=
# One of these, matching the provider (MODEL_API_KEY works for either)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_API_KEY=
# Optional OpenAI-compatible endpoint
OPENAI_BASE_URL=
# Optional portal port (default 8766)
PORTAL_PORT=
